// ClothSelfCollision.usf
//
// Self-collision RESPONSE pass (M9). One thread per particle.
//
// Using the spatial hash grid built by ClothBuildGrid.usf, each particle scans the
// 27 cells around its own (3x3x3 block — since CellSize == the collision thickness,
// every particle within range is in one of those cells) and, for every OTHER particle
// closer than the thickness, accumulates a repulsion that pushes them apart. Each
// thread reads the input snapshot and writes only its own slot in the output buffer
// (Jacobi gather) — no atomics, no races. The opposite endpoint is moved by its own
// thread, so the pair separates symmetrically without double counting.
//
// We SKIP a particle's 1-ring grid neighbours (the structural/shear partners): their
// rest length is < the collision thickness, so colliding them would fight the distance
// solver. Bending (2-away) partners are outside the 1-ring and naturally far enough.

#include "/Engine/Public/Platform.ush"

#ifndef THREADGROUP_SIZE
#define THREADGROUP_SIZE 64
#endif
#ifndef MAX_PER_CELL
#define MAX_PER_CELL 16
#endif

StructuredBuffer<float3>	PredictedIn;	// solved positions (snapshot)
StructuredBuffer<float>		InvMasses;
Buffer<uint>				CellCounts;		// [TableSize] (typed, matches build pass)
StructuredBuffer<uint>		CellParticles;	// [TableSize * MAX_PER_CELL]
RWStructuredBuffer<float3>	PredictedOut;	// this particle's corrected position

uint	NumParticles;
uint	GridWidth;
uint	GridHeight;
uint	TableSize;
float	CellSize;		// = Thickness
float	Thickness;		// minimum separation between non-adjacent particles
float	SelfStiffness;	// [0,1]

uint HashCell(int3 C)
{
	const uint H = (uint)(C.x * 73856093) ^ (uint)(C.y * 19349663) ^ (uint)(C.z * 83492791);
	return H % TableSize;
}

[numthreads(THREADGROUP_SIZE, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint Index = DispatchThreadId.x;
	if (Index >= NumParticles)
	{
		return;
	}

	const float Wi = InvMasses[Index];
	const float3 Pi = PredictedIn[Index];

	if (Wi <= 0.0f)
	{
		PredictedOut[Index] = Pi; // pinned: pass through unchanged
		return;
	}

	const int Gxi = (int)(Index % GridWidth);
	const int Gyi = (int)(Index / GridWidth);
	const int3 BaseCell = (int3)floor(Pi / CellSize);

	float3 Correction = float3(0.0f, 0.0f, 0.0f);

	[loop]
	for (int dz = -1; dz <= 1; ++dz)
	[loop]
	for (int dy = -1; dy <= 1; ++dy)
	[loop]
	for (int dx = -1; dx <= 1; ++dx)
	{
		const uint Bucket = HashCell(BaseCell + int3(dx, dy, dz));
		const uint Count = min(CellCounts[Bucket], (uint)MAX_PER_CELL);

		for (uint s = 0; s < Count; ++s)
		{
			const uint J = CellParticles[Bucket * (uint)MAX_PER_CELL + s];
			if (J == Index)
			{
				continue;
			}

			// Skip the 1-ring grid neighbours (structural + shear partners).
			const int Gxj = (int)(J % GridWidth);
			const int Gyj = (int)(J / GridWidth);
			if (abs(Gxi - Gxj) <= 1 && abs(Gyi - Gyj) <= 1)
			{
				continue;
			}

			const float Wj = InvMasses[J];
			const float WSum = Wi + Wj;
			if (WSum <= 1e-8f)
			{
				continue;
			}

			const float3 D = Pi - PredictedIn[J];
			const float Len = length(D);
			if (Len < Thickness && Len > 1e-5f)
			{
				const float3 N = D / Len;
				Correction += (Wi / WSum) * (Thickness - Len) * N;
			}
		}
	}

	PredictedOut[Index] = Pi + SelfStiffness * Correction;
}
